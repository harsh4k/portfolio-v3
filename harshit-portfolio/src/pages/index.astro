---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Separator from "../components/Separator.astro";
import Work from "../components/Work.astro";
import Archive from "../components/Archive.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import GithubSection from "../components/GithubSection.astro";
import SiteChrome from "../components/SiteChrome.astro";
import ScrollScene from "../components/ScrollScene.astro";
import SiteNav from "../components/SiteNav.astro";
import { profile, toolkit, workSteps } from "../data/profile";

const separatorClass = "style--secondary astro-j7pv25f6 astro-rdpcjfuz";
const motto = ["Do", "Things", "Your", "Way"];
---

<Base title={`${profile.name} — ${profile.role}`} description={profile.description}>
  <Header />
  <!-- Everything between the header and the footer is the page's main content. -->
  <main>
    <Hero />
    <About />
    <ScrollScene id="process" scene="helix" title="How I work" steps={workSteps} length={4} />
    <Separator class={separatorClass} codes={motto} />
    <Work />
    <ScrollScene id="toolkit" scene="rail" title="Toolkit" steps={toolkit} length={4.5} />
    <GithubSection />
    <Separator class={separatorClass} codes={motto} />
    <Archive />
    <Contact />
  </main>
  <Footer />
  <SiteNav />
  <SiteChrome slot="after" />
</Base>
