---
import Notice from "../layouts/Notice.astro";

/**
 * Shown by the offline worker (public/sw.js) for a page it has no copy of while
 * there is no connection. Not listed in the sitemap.
 */
---

<Notice title="Offline" code="Offline" heading="No connection.">
