---
import { profile } from "../data/profile";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found — {profile.name}</title>
    <link rel="icon" href="/icons/favicon.ico" />
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <h1>Nothing here.</h1>
      <p>The page you were looking for doesn't exist or has moved.</p>
      <a href="/">Back to the portfolio</a>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "PP Editorial New";
    src: url("/fonts/PPEditorialNew-Regular.woff2") format("woff2");
    font-display: swap;
  }

  body {
    display: grid;
    place-items: center;
    min-height: 100svh;
    margin: 0;
    padding: 1.5rem;
    background: #f40c3f;
    color: #160000;
    font-family: "PP Editorial New", Georgia, serif;
    text-align: center;
  }

  .code {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
  }

  a {
    color: inherit;
  }
</style>
