---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base title={`Page not found — ${profile.name}`} description="This page doesn't exist.">
  <main id="main" class="missing wrap">
    <p class="label muted">404</p>
    <h1>Nothing here.</h1>
    <p>The page you were looking for doesn't exist or has moved.</p>
    <a class="button button--solid" href="/">
      Back to the portfolio
    </a>
  </main>
</Base>

<style>
  .missing {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    min-height: 100svh;
  }

  h1 {
    font-size: clamp(3.5rem, 12vw, 9rem);
  }
</style>
