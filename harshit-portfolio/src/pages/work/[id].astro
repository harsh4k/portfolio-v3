---
/**
 * A page per project: what it is, the live and source links, and the
 * case-study lines (role, stack, problem, outcome) from
 * src/content/projects.json, each shown only when it is filled in. A light page of its own, without the home page's
 * engine, in the site's red and ink.
 */
import type { GetStaticPaths } from "astro";
import { getOrdered } from "../../data/collections";
import { profile } from "../../data/profile";

export const getStaticPaths = (async () => {
  const projects = await getOrdered("projects");
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project: project.data,
      index,
      total: projects.length,
      previous: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

const { project, index, total, previous, next } = Astro.props;
const title = `${project.title} — ${profile.name}`;
const description = project.summary
  ? `${project.title}: ${project.summary}. Built by ${profile.name}, ${profile.role.toLowerCase()} in ${profile.location}.`
  : `${project.title}, built by ${profile.name}, ${profile.role.toLowerCase()} in ${profile.location}.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(project.image, Astro.site);
const key = `#${project.code}-${String(index + 1).padStart(4, "0")}/${total}`;
const host = new URL(project.url).host.replace(/^www\./, "");
const onGithub = host === "github.com";
const number = String(index + 1).padStart(2, "0");
const story = [
  { heading: "The problem", text: project.problem },
  { heading: "The result", text: project.outcome },
].filter((part): part is { heading: string; text: string } => Boolean(part.text));
const caseStudy = story.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/icons/logo.png" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <meta name="theme-color" content="#F40C3F" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/Bigger-Display.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="bar">
      <a href="/#work" class="back">
        ← All work
      </a>
      <span class="key">{key}</span>
    </header>

    <main>
      <header class="intro">
        <p class="eyebrow">
          {caseStudy ? "Case study" : "Project"} · {number} / {String(total).padStart(2, "0")}
        </p>
        <h1>{project.title}</h1>
        {project.summary && <p class="summary">{project.summary}</p>}
        <p class="links">
          <a class="link link--solid" href={project.url} target="_blank" rel="noopener noreferrer">
            {onGithub ? "Source on GitHub" : `Visit ${host}`} <span aria-hidden="true">↗</span>
          </a>
          {project.repo && (
            <a class="link" href={project.repo} target="_blank" rel="noopener noreferrer">
              Source on GitHub <span aria-hidden="true">↗</span>
            </a>
          )}
        </p>
      </header>

      {(project.role || project.stack) && (
        <dl class="meta">
          {project.role && (
            <div>
              <dt>Role</dt>
              <dd>{project.role}</dd>
            </div>
          )}
          {project.stack && (
            <div>
              <dt>Stack</dt>
              <dd>
                <ul class="stack">
                  {project.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      )}

      <figure class="shot">
        <div class="shot__bar" aria-hidden="true">
          <span class="shot__dots">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span class="shot__host">{onGithub ? project.title : host}</span>
        </div>
        <img src={project.image} alt={`${project.title}, home page`} width="1082" height="636" decoding="async" />
      </figure>

      {story.length > 0 && (
        <section class="story" aria-label="Case study">
          {story.map((part, i) => (
            <article class="story__row">
              <h2>
                <span>{String(i + 1).padStart(2, "0")}</span>
                {part.heading}
              </h2>
              <p>{part.text}</p>
            </article>
          ))}
        </section>
      )}
    </main>

    <nav class="pager" aria-label="More projects">
      {previous && (
        <a href={`/work/${previous.id}/`} rel="prev">
          <span>Previous</span>
          {previous.data.title}
        </a>
      )}
      {next && (
        <a href={`/work/${next.id}/`} rel="next">
          <span>Next</span>
          {next.data.title}
        </a>
      )}
    </nav>

    <footer class="foot">
      <a href="/">{profile.name}</a>
      <span>
        {profile.role} · {profile.location}
      </span>
    </footer>
    <script>
      import "../../scripts/offline";
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Bigger Display";
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/Bigger-Display.woff2") format("woff2");
  }

  @font-face {
    font-family: "Fraktion Mono";
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/PPFraktionMono-Regular.woff2") format("woff2");
  }

  @font-face {
    font-family: "Fraktion Mono";
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/PPFraktionMono-Bold.woff2") format("woff2");
  }

  @font-face {
    font-family: "Editorial New";
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/PPEditorialNew-Regular.woff2") format("woff2");
  }

  :root {
    --ground: #f40c3f;
    --ink: #160000;
    --display: "Bigger Display", "Arial Narrow", sans-serif;
    --mono: "Fraktion Mono", ui-monospace, monospace;
    --serif: "Editorial New", Georgia, serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font: 400 18px/1.5 var(--serif);
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .bar,
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1rem 1.5rem;
    font: 700 12px/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bar {
    border-bottom: 1px solid var(--ink);
  }

  .back {
    text-decoration: none;
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 1.5rem clamp(3rem, 7vw, 6rem);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
  }

  .intro .eyebrow {
    margin-bottom: 1rem;
  }

  .eyebrow,
  .meta dt,
  .story h2 span {
    margin: 0;
    font: 700 12px/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font: 700 clamp(4rem, 16vw, 13rem) / 0.82 var(--display);
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .summary {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ink);
    font: 700 13px/1 var(--mono);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .link--solid,
  .link:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .link--solid:hover {
    background: transparent;
    color: var(--ink);
  }

  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .meta div {
    padding: 1.25rem 1.5rem 1.25rem 0;
  }

  .meta div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--ink);
  }

  .meta dd {
    margin: 0.5rem 0 0;
    font-size: 1.125rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--ink);
    font: 400 12px/1.2 var(--mono);
    letter-spacing: 0.04em;
  }

  .shot {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border: 1px solid var(--ink);
    background: var(--ink);
  }

  .shot__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    color: var(--ground);
    font: 400 12px/1 var(--mono);
    letter-spacing: 0.06em;
  }

  .shot__dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .shot__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--ground);
    border-radius: 50%;
  }

  .shot__host {
    flex: 1;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .story {
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--ink);
  }

  .story__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1rem 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--ink);
  }

  .story h2 {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    margin: 0;
    font: 700 clamp(1.75rem, 3.5vw, 2.75rem) / 0.9 var(--display);
    text-transform: uppercase;
  }

  .story p {
    max-width: 58ch;
    margin: 0;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .meta,
    .story__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .meta div + div {
      padding-left: 0;
      border-top: 1px solid var(--ink);
      border-left: 0;
    }

    .shot__dots {
      display: none;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .pager a {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem;
    font: 700 clamp(1.75rem, 5vw, 3.5rem) / 0.9 var(--display);
    text-decoration: none;
    text-transform: uppercase;
  }

  .pager a + a {
    border-left: 1px solid var(--ink);
    text-align: right;
  }

  .pager span {
    font: 700 12px/1.4 var(--mono);
    letter-spacing: 0.1em;
  }

  .pager a:hover,
  .pager a:focus-visible {
    background: var(--ink);
    color: var(--ground);
  }
</style>
