---
import FooterWordmark from "./FooterWordmark";
import { profile } from "../data/profile";
---

<footer class="site-foot site-foot--wordmark astro-75cegwoc">
  <p class="site-foot__status">
    <span>{profile.location}</span>
    <span aria-hidden="true">·</span>
    <span>
      <time class="js-local-time" data-zone={profile.timeZone}>
        IST
      </time>{" "}
      local time
    </span>
    <span aria-hidden="true">·</span>
    <span>{profile.availability}</span>
  </p>
  <!--
    HARSHIT CHAUHAN in Audiowide with the shutter-glyph animations
    (src/components/FooterWordmark.tsx). Server-rendered, then hydrated by
    scripts/footer-wordmark.tsx. No whitespace inside the div: React hydrates
    its whole content.
  -->
  <!-- prettier-ignore -->
  <div class="site-foot__mark js-wordmark"><FooterWordmark /></div>
  <p class="site-foot__credit">
    <span>
      Design inspired by{" "}
      <a href="https://wodniack.dev" target="_blank" rel="noopener noreferrer">
        Antoine Wodniack
      </a>
    </span>
    <span aria-hidden="true">·</span>
    <span>
      Intro inspired by{" "}
      <a href="https://adrienlamy.fr" target="_blank" rel="noopener noreferrer">
        Adrien Lamy
      </a>
    </span>
  </p>
</footer>

<script>
  import "../scripts/footer-wordmark";
  import "../scripts/footer-meta";
</script>

<style is:global>
  /* Audiowide by Brian J. Bonislawsky (Astigmatic), SIL Open Font License 1.1.
     Self-hosted, latin subset: the CSP's font-src only allows this origin. */
  @font-face {
    font-family: "Audiowide";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/Audiowide-Regular.woff2") format("woff2");
  }

  /*
    The status line centred over the wordmark, in a thin strip. Two classes to
    beat the design's flex row on .site-foot. Below 988px the wordmark spans
    the width, so the bottom padding keeps the corner Jump button
    (SiteNav.astro) off it.
  */
  .site-foot.site-foot--wordmark {
    --sgf-ink: var(--color-secondary, #160000);
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
  }

  @media only screen and (max-width: 987px) {
    .site-foot.site-foot--wordmark {
      padding-bottom: calc(3.75rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .site-foot__status {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.6rem;
    margin: 0;
    min-width: 0;
    color: var(--color-secondary);
    font: 400 12px/1.5 var(--font-family-fraktion);
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .site-foot__status time {
    font-variant-numeric: tabular-nums;
  }

  /* Credit for the sites this one's look and intro grew out of. */
  .site-foot__credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.5rem;
    margin: 0;
    color: var(--color-secondary);
    font: 400 11px/1.5 var(--font-family-fraktion);
    letter-spacing: 0.04em;
    text-align: center;
  }

  .site-foot__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-foot__mark {
    max-width: 100%;
    font-family: "Audiowide", var(--font-family-fraktion, sans-serif);
    font-size: clamp(1.25rem, 5.4vw, 2.75rem);
  }
</style>
