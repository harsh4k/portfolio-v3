---
import FooterWordmark from "./FooterWordmark";
---

<footer class="site-foot site-foot--wordmark astro-75cegwoc">
  <!--
    HARSHIT CHAUHAN in the shutter-glyph lettering (src/components/FooterWordmark.tsx).
    Server-rendered, then hydrated by scripts/footer-wordmark.tsx. One line on
    wide screens, two on phones; only one of the two is shown. No whitespace
    inside the divs: React hydrates their whole content.
  -->
  <!-- prettier-ignore -->
  <div class="site-foot__mark site-foot__mark--wide js-wordmark" data-variant="wide"><FooterWordmark variant="wide" /></div>
  <!-- prettier-ignore -->
  <div class="site-foot__mark site-foot__mark--stacked js-wordmark" data-variant="stacked"><FooterWordmark variant="stacked" /></div>
</footer>

<script>
  import "../scripts/footer-wordmark";
</script>

<style is:global>
  .site-foot--wordmark {
    --sgf-ink: var(--color-secondary, #160000);
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 2.6vw, 2.5rem);
  }

  .site-foot__mark {
    width: 100%;
  }

  .site-foot__mark--stacked {
    display: none;
  }

  @media (max-width: 47.99em) {
    .site-foot__mark--wide {
      display: none;
    }

    .site-foot__mark--stacked {
      display: block;
    }
  }
</style>
