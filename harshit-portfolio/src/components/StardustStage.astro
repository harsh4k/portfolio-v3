---
/**
 * The hero's stardust scene, in the band the wave lines used to fill. The
 * markup here is the static frame; src/scripts/stardust-stage.ts sizes and
 * paints everything else, and these styles move it. The .ssp- class prefix
 * and the --ssp- custom properties keep it apart from the copied design.
 */
---

<div class="ssp-root js-stardust" aria-hidden="true">
  <div class="ssp-layer ssp-sky"></div>
  <div class="ssp-layer js-ssp-sparks"></div>
  <div class="ssp-layer js-ssp-scene"></div>
  <canvas class="ssp-dots"></canvas>

  <div class="ssp-layer ssp-rain"></div>
  <div class="ssp-layer ssp-grain"></div>
</div>

<script>
  import "../scripts/stardust-stage";
</script>

<style is:global>
  /* The scene replaces the wave lines: their element stays for the hero's intro timeline, undrawn. */
  .s-hero .s__waves {
    position: relative;
  }

  .s-hero .s__waves .js-svg {
    display: none;
  }

  .ssp-root {
    --ssp-stage: var(--color-primary, #f40c3f);
    --ssp-ink: var(--color-secondary, #160000);
    /* Highlights: the design's off-white, so glows read as light on the red. */
    --ssp-light: var(--color-white, #fff0eb);
    --ssp-mx: 0;
    --ssp-my: 0;

    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    background: var(--ssp-stage);
    color: var(--ssp-ink);
    font-family: var(--font-family-fraktion, monospace);
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ssp-root svg,
  .ssp-root canvas,
  .ssp-root img {
    max-width: none;
  }

  .ssp-root p {
    margin: 0;
  }

  .ssp-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ---- the sky ---- */
  .ssp-sky {
    inset: -4%;
    background-image: var(--ssp-stars);
    background-size: 512px 512px;
    opacity: 1;
    transform: translate3d(calc(var(--ssp-mx) * -8px), calc(var(--ssp-my) * -6px), 0);
  }

  .ssp-spark {
    position: absolute;
    display: block;
    fill: var(--ssp-ink);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--ssp-light) 55%, transparent));
    animation: ssp-twinkle 3.6s ease-in-out infinite;
  }

  .ssp-skyspark {
    transform: translate(-50%, -50%);
  }

  .ssp-planet-par {
    position: absolute;
    width: 0;
    height: 0;
    transform: translate3d(calc(var(--ssp-mx) * var(--d) * -1px), calc(var(--ssp-my) * var(--d) * -1px), 0);
  }

  /* Stippled like the moon and clouds; each fades in with the stage, then floats. */
  .ssp-planet {
    position: absolute;
    background-size: 100% 100%;
    opacity: 0;
    transition: opacity 1.6s ease;
    animation: ssp-float var(--f) ease-in-out infinite alternate;
  }

  .ssp-root[data-shown] .ssp-planet {
    opacity: 1;
    transition-delay: var(--w);
  }

  /* ---- the dots ---- */
  .ssp-dots {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }

  /* ---- the stage ---- */
  .ssp-stage {
    position: absolute;
    pointer-events: none;
    transform-origin: 50% 40%;
  }

  .ssp-par {
    position: absolute;
    inset: 0;
  }

  .ssp-par-far {
    transform: translate3d(calc(var(--ssp-mx) * -6px), calc(var(--ssp-my) * -4px), 0);
  }

  .ssp-par-mid {
    transform: translate3d(calc(var(--ssp-mx) * -12px), calc(var(--ssp-my) * -6px), 0);
  }

  .ssp-par-near {
    transform: translate3d(calc(var(--ssp-mx) * -20px), calc(var(--ssp-my) * -8px), 0);
  }

  .ssp-moon {
    position: absolute;
    border-radius: 50%;
    background-size: 100% 100%;
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 1.4s ease,
      transform 2.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ssp-root[data-shown] .ssp-moon {
    opacity: 1;
    transform: none;
    transition-delay: 1.5s;
  }

  .ssp-moonglow {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--ssp-light) 26%, transparent),
      color-mix(in srgb, var(--ssp-light) 6%, transparent) 55%,
      transparent
    );
    opacity: 0;
    transition: opacity 2s ease 1.6s;
  }

  .ssp-root[data-shown] .ssp-moonglow {
    opacity: 1;
  }

  .ssp-cloud {
    position: absolute;
    opacity: 0;
    transform: translate3d(0, 34%, 0);
    transition:
      transform 2.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 1.6s ease;
  }

  .ssp-root[data-shown] .ssp-cloud {
    opacity: 1;
    transform: none;
    transition-delay: var(--w);
  }

  .ssp-cloud-drift,
  .ssp-curtain-sway {
    position: absolute;
    inset: 0;
    background-image: var(--bg);
    background-size: 100% 100%;
  }

  .ssp-cloud-drift {
    animation: ssp-drift var(--f) ease-in-out infinite alternate;
  }

  .ssp-arch {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    fill: none;
    stroke: var(--ssp-ink);
    stroke-linecap: round;
  }

  .ssp-draw {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 2.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .ssp-root[data-shown] .ssp-draw {
    stroke-dashoffset: 0;
    transition-delay: var(--w);
  }

  .ssp-orn {
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .ssp-root[data-shown] .ssp-orn {
    opacity: 1;
    transition-delay: 2s;
  }

  .ssp-curtain {
    position: absolute;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 2.2s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .ssp-curtain-r {
    transform: scaleX(-1);
  }

  .ssp-root[data-shown] .ssp-curtain {
    clip-path: inset(0 0 0 0);
    transition-delay: 1.1s;
  }

  .ssp-curtain-sway {
    transform-origin: 50% 0;
    animation: ssp-sway 7s ease-in-out infinite alternate;
  }

  .ssp-figure {
    position: absolute;
    background-size: 100% 100%;
    opacity: 0;
    transform: translateY(8%);
    transition:
      opacity 1.4s ease,
      transform 2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ssp-root[data-shown] .ssp-figure {
    opacity: 1;
    transform: none;
    transition-delay: 2.1s;
  }

  .ssp-pool {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--ssp-light) 32%, transparent),
      color-mix(in srgb, var(--ssp-light) 8%, transparent) 50%,
      transparent
    );
    opacity: 0;
    transition: opacity 1.6s ease 1.9s;
  }

  .ssp-root[data-shown] .ssp-pool {
    opacity: 1;
  }

  .ssp-mirror {
    position: absolute;
    left: 0;
    overflow: hidden;
    opacity: 0.4;
    filter: blur(0.6px);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 75%);
    mask-image: linear-gradient(to bottom, #000, transparent 75%);
  }

  .ssp-mirror-flip {
    position: absolute;
    left: 0;
  }

  .ssp-stagespark {
    opacity: 0;
    transition: opacity 1s ease;
  }

  .ssp-root[data-shown] .ssp-stagespark {
    opacity: 1;
    transition-delay: 2.4s;
  }

  /* ---- weather, lens and film ---- */
  .ssp-rain {
    background-image: var(--ssp-rain);
    background-size: 256px 256px;
    opacity: 0;
    transition: opacity 2s ease 1s;
    animation: ssp-rain 0.9s linear infinite;
  }

  .ssp-root[data-shown] .ssp-rain {
    opacity: 0.3;
  }

  .ssp-grain {
    inset: -50%;
    opacity: 0.5;
    mix-blend-mode: overlay;
    background-image: var(--ssp-grain);
    background-size: 160px 160px;
    animation: ssp-grain 0.8s steps(5) infinite;
  }

  @keyframes ssp-twinkle {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(0.55) rotate(0deg);
      opacity: 0.45;
    }

    50% {
      transform: translate(-50%, -50%) scale(1) rotate(45deg);
      opacity: 1;
    }
  }

  @keyframes ssp-float {
    from {
      transform: translate3d(0, -4%, 0);
    }

    to {
      transform: translate3d(0, 4%, 0);
    }
  }

  @keyframes ssp-drift {
    from {
      transform: translate3d(-1.2%, 0, 0);
    }

    to {
      transform: translate3d(1.2%, -1%, 0);
    }
  }

  @keyframes ssp-sway {
    from {
      transform: skewX(-0.6deg);
    }

    to {
      transform: skewX(0.6deg);
    }
  }

  @keyframes ssp-rain {
    from {
      background-position: 0 0;
    }

    to {
      background-position: -24px 256px;
    }
  }

  @keyframes ssp-grain {
    0% {
      transform: translate(0, 0);
    }

    25% {
      transform: translate(-6%, 4%);
    }

    50% {
      transform: translate(5%, -6%);
    }

    75% {
      transform: translate(-3%, -8%);
    }

    100% {
      transform: translate(7%, 3%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ssp-planet,
    .ssp-cloud-drift,
    .ssp-curtain-sway,
    .ssp-grain {
      animation: none;
    }

    .ssp-spark {
      animation: none;
      transform: translate(-50%, -50%);
    }

    .ssp-rain {
      display: none;
    }

    .ssp-cloud,
    .ssp-moon,
    .ssp-figure {
      transition-property: opacity;
    }

    .ssp-curtain {
      transition: none;
    }

    .ssp-draw {
      transition-duration: 0.01s;
    }
  }
</style>
