---
import { profile, hireMe } from "../data/profile";

const github = profile.socials.find((social) => social.label === "GitHub");

const links = [
  { href: "#about", label: "About" },
  { href: "#work", label: "Work" },
  { href: "#archive", label: "Archive" },
  { href: "#contact", label: "Contact" },
];
---

<header class="header">
  <div class="header__inner wrap">
    <a class="header__brand label" href="#top" aria-label={`${profile.name}, back to top`}>
      <span class="header__mark" aria-hidden="true">
        HC
      </span>
      <span class="header__name">{profile.name}</span>
    </a>

    <nav class="header__nav" aria-label="Sections">
      <ul>
        {links.map((link) => (
          <li>
            <a class="label" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a class="label" href={profile.resume.pdf} target="_blank" rel="noopener">
            Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>

    {github && (
      <a class="header__icon" href={github.url} target="_blank" rel="noopener me">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span class="visually-hidden">GitHub (opens in a new tab)</span>
      </a>
    )}

    <a class="header__hire button button--solid" href={hireMe}>
      Hire me
    </a>

    <button class="header__theme" type="button" data-theme-toggle aria-pressed="false">
      <span class="visually-hidden">Dark theme</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  const isDark = () => (root.dataset.theme ?? (media.matches ? "dark" : "light")) === "dark";
  const sync = () => button?.setAttribute("aria-pressed", String(isDark()));

  button?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage blocked: the choice lasts for this page view only.
    }
    sync();
  });
  media.addEventListener("change", sync);
  sync();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .header__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    letter-spacing: 0;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    text-decoration: none;
  }

  .header__nav a:hover {
    color: var(--accent);
  }

  .header__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--ink);
    transition: color 0.2s;
  }

  .header__icon:hover {
    color: var(--accent);
  }

  .header__hire {
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    white-space: nowrap;
  }

  .header__theme {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .header__theme:hover {
    border-color: var(--ink);
  }

  /* On phones the brand shrinks to the mark and the nav keeps its four anchors. */
  @media (max-width: 47.99rem) {
    .header__name,
    .header__nav li:nth-child(3),
    .header__hire {
      display: none;
    }

    .header__nav ul {
      gap: 0.25rem;
    }

    .header__nav .label {
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }
  }
</style>
