---
/**
 * Harshit's logo: the mascot badge (the intro face on a disc).
 * Colours come from the theme (see .logo-badge in src/styles/site.css), so it
 * follows the contrast toggle. Drawn on a 100x100 grid; size it with CSS.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  class:list={["logo-badge", className]}
  viewBox="0 0 100 100"
  width="100"
  height="100"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <circle class="logo-badge__ink" cx="50" cy="50" r="50"></circle>
  <!-- Head silhouette in paper, stroked wide so the hair reads against the disc. -->
  <g class="logo-badge__paper logo-badge__cutout">
    <ellipse cx="23" cy="62" rx="6.5" ry="7.5"></ellipse>
    <ellipse cx="77" cy="62" rx="6.5" ry="7.5"></ellipse>
    <path d="M23 60 C23 42 35 34 50 34 C65 34 77 42 77 60 C77 77 66 88 50 88 C34 88 23 77 23 60 Z"></path>
    <path d="M20 60 C15 46 16 34 22 27 L18 22 L27 20 C31 15 37 11 43 10 L44 5 L51 9 C56 7 62 8 66 10 L70 7 L72 13 C78 16 83 22 85 28 L90 30 L86 36 C88 44 86 52 81 60 L79 47 C76 44 73 42 70 41 L71 50 C67 46 63 43 58 41 L60 51 C55 46 50 43 45 41 L48 52 C43 47 38 44 33 43 L36 53 C32 49 29 47 26 46 L26 57 Z"></path>
  </g>
  <g class="logo-badge__ink">
    <!-- Mop hair; every fringe lock tips down and to the right. -->
    <path d="M20 60 C15 46 16 34 22 27 L18 22 L27 20 C31 15 37 11 43 10 L44 5 L51 9 C56 7 62 8 66 10 L70 7 L72 13 C78 16 83 22 85 28 L90 30 L86 36 C88 44 86 52 81 60 L79 47 C76 44 73 42 70 41 L71 50 C67 46 63 43 58 41 L60 51 C55 46 50 43 45 41 L48 52 C43 47 38 44 33 43 L36 53 C32 49 29 47 26 46 L26 57 Z"></path>
    <!-- Half-closed pupils -->
    <path d="M35.6 64.4 A3.3 3.3 0 0 0 42.2 64.4 Z"></path>
    <path d="M58.6 64.4 A3.3 3.3 0 0 0 65.2 64.4 Z"></path>
  </g>
  <g class="logo-badge__line">
    <!-- Eyelids, smirk, ear curls -->
    <path d="M33 64 Q38.5 61.5 44 64"></path>
    <path d="M56 64 Q61.5 61.5 67 64"></path>
    <path d="M44 77 Q52 80.5 59 74.5"></path>
    <path d="M58 73 L61 76"></path>
    <path d="M22 59 Q20 62.5 23.5 65.5"></path>
    <path d="M78 59 Q80 62.5 76.5 65.5"></path>
  </g>
  <g class="logo-badge__line logo-badge__line--fine">
    <!-- Blush -->
    <path d="M30 70 l-1.3 3 M33 70 l-1.3 3"></path>
    <path d="M69 70 l-1.3 3 M72 70 l-1.3 3"></path>
  </g>
</svg>
