---
import { getOrdered } from "../data/collections";
import { profile } from "../data/profile";

const photos = await getOrdered("archive");
// Ten loose stars scatter among the photos.
const stars = Array.from({ length: 10 });
const catchLines = ["Building", "with intent", "since", String(profile.since)];
---

<section class="s-my-way astro-fiibiggq" data-intersect>
  <svg
    class="s__smiley js-smiley astro-fiibiggq"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 77.8 77.8"
    xml:space="preserve"
  >
    <circle cx="38.9" cy="38.9" r="38.9" class="astro-fiibiggq"></circle>
    <path
      d="M38.9 77.8c-2 0-4.1-.2-6.2-.5C11.6 73.9-2.9 53.9.5 32.8 2.1 22.5 7.7 13.5 16.1 7.4c8.4-6.1 18.7-8.5 29-6.9 10.3 1.6 19.3 7.2 25.4 15.6 6.1 8.4 8.5 18.7 6.9 29-3.1 19.1-19.7 32.7-38.5 32.7zM38.8 1c-7.9 0-15.6 2.5-22.1 7.2C8.5 14.1 3.1 22.9 1.5 32.9-1.8 53.5 12.3 73 32.9 76.3 53.5 79.6 73 65.5 76.3 44.9l.5.1-.5-.1c1.6-10-.8-20-6.7-28.2S54.9 3.1 44.9 1.5c-2-.3-4.1-.5-6.1-.5zM25.5 23.1c-1.9 0-3.5 2-4.1 5.1l-.1.3 3 2.2-2.9 2.2.1.3c.6 2.5 1.5 5.1 4.1 5.1 2.4 0 4.2-3.3 4.2-7.6s-2.4-7.6-4.3-7.6zm26.6 0c-1.9 0-3.5 2-4.1 5.1v.3l3 2.2-3 2.2.1.3c.6 2.5 1.5 5.1 4.1 5.1 2.4 0 4.2-3.3 4.2-7.6s-2.3-7.6-4.3-7.6zM62 39c0-.3-.2-.5-.5-.5s-.5.2-.5.5c0 12.2-9.9 22.1-22.1 22.1-12.2 0-22.1-9.9-22.1-22.1 0-.3-.2-.5-.5-.5s-.5.2-.5.5c0 12.7 10.4 23.1 23.1 23.1S62 51.7 62 39z"
      class="astro-fiibiggq"
    ></path>
  </svg>
  <div class="s__objects js-objects astro-fiibiggq">
    {photos.map(({ data }) => (
      <div class="a-object a-object--frame astro-fiibiggq">
        <figure class="a__inner astro-fiibiggq">
          <img
            src={data.image}
            alt={data.caption}
            class="a__img astro-fiibiggq"
            width={data.width}
            height={data.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption class="a__caption astro-fiibiggq">{data.caption}</figcaption>
        </figure>
        <div class="a__side a__side--vertical astro-fiibiggq"></div>
        <div class="a__side a__side--horizontal astro-fiibiggq"></div>
      </div>
    ))}
    {stars.map(() => (
      <div class="a-object a-object--star astro-fiibiggq">
        <div class="a__side a__side--top-left astro-fiibiggq"></div>
        <div class="a__side a__side--top-right astro-fiibiggq"></div>
        <div class="a__side a__side--bottom-left astro-fiibiggq"></div>
        <div class="a__side a__side--bottom-right astro-fiibiggq"></div>
      </div>
    ))}
    <div class="s__ruler js-ruler astro-fiibiggq"></div>
  </div>
  <div class="s__catcher astro-fiibiggq">
    {["distorted", "normal"].map((variant) => (
      <div class={`s__catcher__${variant}-wrapper astro-fiibiggq`}>
        <div class={`s__catcher__${variant} astro-fiibiggq`}>
          <div class={`s__catcher__text s__catcher__text--${variant} astro-fiibiggq`}>
            {catchLines.map((line, index) => (
              <>
                {line}
                {index < catchLines.length - 1 && <br class="astro-fiibiggq" />}
              </>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
  <svg class="s__svg js-svg astro-fiibiggq">
    <path class="s__svg__circular-path js-lines-circular-path astro-fiibiggq" d=""></path>
  </svg>
</section>
