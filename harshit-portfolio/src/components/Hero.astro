---
import Separator from "./Separator.astro";
import WireTerrainStage from "./WireTerrainStage.astro";
import { profile } from "../data/profile";

const [first, second] = profile.heroTitle;
const separatorClass = "style--primary s__separator js-separator astro-7dteeuzc astro-rdpcjfuz";
---

<div class="s-hero astro-7dteeuzc" data-intersect>
  <!--
    The engine's hero intro slides this element in and draws its lines, so it
    stays; without data-intersect its lines never animate, and the wire
    terrain fills it instead (their svg is hidden in WireTerrainStage.astro).
  -->
  <a-waves class="s__waves astro-7dteeuzc astro-opemy3db">
    <svg class="js-svg astro-opemy3db"></svg>
    <WireTerrainStage />
  </a-waves>
  <div class="s__content js-content astro-7dteeuzc">
    <Separator class={separatorClass} codes={["Har", "sh", "it", "Ch", "au", "ha", "n"]} />
    <h1 class="s__title astro-7dteeuzc">
      <!-- The words are split into one span per letter once the page loads; screen readers get the plain words instead. -->
      <span class="u-sr-only astro-7dteeuzc">
        {first} {second}
      </span>
      <span class="s__title__word js-word astro-7dteeuzc" aria-hidden="true">
        {first}
      </span>
      <img class="s__title__asset js-star astro-7dteeuzc" src="/images/asset-star.svg" alt="" width="48" height="48" />
      <span class="s__title__word js-word astro-7dteeuzc" aria-hidden="true">
        {second}
      </span>
    </h1>
    <Separator class={separatorClass} codes={["Do", "Things", "Your", "Way"]} />
  </div>
  <div class="s__border js-border astro-7dteeuzc"></div>
</div>
