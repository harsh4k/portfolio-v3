---
import { hireMe, profile } from "../data/profile";

const [first = "", last = ""] = profile.role.split(" ");

// Contour lines for the banner: vertical strokes bent by two overlapping
// sine waves. Generated at build time, so the page ships plain SVG.
const lineCount = 90;
const contours = Array.from({ length: lineCount }, (_, i) => {
  const x = (i / (lineCount - 1)) * 1000;
  const points = Array.from({ length: 41 }, (_, j) => {
    const y = j * 10;
    const bend =
      Math.sin(j / 6 + i / 14) * 18 * Math.sin(i / 30) + Math.exp(-(((i - 22) / 12) ** 2)) * Math.sin(j / 4) * 26;
    return `${(x + bend).toFixed(1)},${y}`;
  });
  return points.join(" ");
});

// A strip of binary digits, like a data readout, either side of the title.
const bits = (seed: number) =>
  Array.from({ length: 320 }, (_, i) => ((Math.sin(i * 12.9898 + seed * 78.233) * 43758.5453) % 1 > 0 ? 1 : 0)).join(
    "",
  );
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="hero__contours" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
    {contours.map((points) => (
      <polyline points={points} />
    ))}
  </svg>

  <p class="hero__strip mono" aria-hidden="true">
    <span>{bits(1)}</span>
  </p>

  <h1 class="hero__title" id="hero-title">
    <span class="visually-hidden">
      {profile.name}, {profile.role}
    </span>
    <span class="hero__word" aria-hidden="true">
      {first}
    </span>
    <span class="hero__star" aria-hidden="true">
      ✦
    </span>
    <span class="hero__word" aria-hidden="true">
      {last}
    </span>
  </h1>

  <p class="hero__strip mono" aria-hidden="true">
    <span>{bits(2)}</span>
  </p>

  <div class="hero__body wrap">
    <p class="hero__status mono">
      <span class="hero__dot" aria-hidden="true"></span>
      {profile.name} · Available for projects & roles
    </p>

    <p class="hero__lead">
      Computer Engineering student in Mumbai. I design and build production web applications, motion-led studio sites
      and local-first AI tools, balancing performance, interaction and clean systems.
    </p>

    <ul class="hero__actions">
      <li>
        <a class="pill pill--solid" href={hireMe}>
          Hire me
        </a>
      </li>
      <li>
        <a class="pill" href="#work">
          See the work
        </a>
      </li>
      <li>
        <a class="pill" href={profile.resume.pdf} target="_blank" rel="noopener">
          Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span>
        </a>
      </li>
    </ul>

    <dl class="hero__meta mono">
      <div>
        <dt>Based in</dt>
        <dd>{profile.location}</dd>
      </div>
      <div>
        <dt>Local time</dt>
        <dd>
          <time data-clock data-time-zone={profile.timeZone}>
            IST, UTC+5:30
          </time>
        </dd>
      </div>
      <div>
        <dt>Building since</dt>
        <dd>{profile.since}</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  const timeZone = clock?.dataset.timeZone;

  if (clock && timeZone) {
    const format = new Intl.DateTimeFormat("en-IN", {
      timeZone,
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const tick = () => {
      clock.textContent = `${format.format(new Date())} IST`;
    };
    tick();
    window.setInterval(tick, 30_000);
  }
</script>

<style>
  .hero {
    padding-bottom: clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--ink);
  }

  .hero__contours {
    display: block;
    width: 100%;
    height: clamp(12rem, 32vw, 26rem);
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }

  .hero__contours polyline {
    vector-effect: non-scaling-stroke;
  }

  .hero__strip {
    overflow: hidden;
    padding-block: 0.35rem;
    border-block: 1px solid var(--ink);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    white-space: nowrap;
  }

  .hero__strip span {
    display: inline-block;
  }

  .hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.12em;
    padding: 0.08em var(--gutter) 0.02em;
    font-size: clamp(3.75rem, 13vw, 12rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
  }

  .hero__star {
    font-family: var(--mono);
    font-size: 0.35em;
    line-height: 1;
  }

  .hero__body {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .hero__lead {
    max-width: 34ch;
    font-size: clamp(1.4rem, 1.6vw + 0.9rem, 2.25rem);
    line-height: 1.2;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .hero__meta dd {
    margin-top: 0.35rem;
    font-weight: 700;
  }

  @media (min-width: 60rem) {
    .hero__body {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .hero__status,
    .hero__meta {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__strip span {
      animation: ticker 40s linear infinite;
    }

    .hero__strip + .hero__title + .hero__strip span {
      animation-direction: reverse;
    }

    .hero__word {
      animation: rise 0.9s var(--ease) both;
    }

    .hero__word:last-child {
      animation-delay: 0.08s;
    }

    @keyframes ticker {
      to {
        transform: translateX(-50%);
      }
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.3em);
      }
    }
  }
</style>
