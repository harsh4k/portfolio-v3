---
import Avatar from "./Avatar.astro";
import { profile, hireMe } from "../data/profile";

const [first, last] = profile.name.split(" ");
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <canvas class="hero__sky" aria-hidden="true" data-sky></canvas>

  <div class="hero__inner wrap">
    <p class="hero__eyebrow label">
      <span class="hero__status">
        <span class="hero__dot" aria-hidden="true"></span>Available for projects & roles
      </span>
    </p>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__line">{first}</span>
      <span class="hero__line hero__line--indent">
        {last}
        <span class="hero__stop" aria-hidden="true">
          .
        </span>
      </span>
      <span class="hero__role">{profile.role}</span>
    </h1>

    <div class="hero__portrait avatar-wrap" data-no-sky>
      <Avatar class="hero__avatar" />
    </div>

    <div class="hero__foot">
      <p class="hero__lead">
        Computer Engineering student in Mumbai and intern at Synapical. I design and build production web applications,
        desktop tools and local-first AI, balancing performance, interaction and clean systems.
      </p>

      <div class="hero__actions">
        <a class="button button--solid" href={hireMe}>
          Hire me
        </a>
        <a class="button" href="#work">
          See the work
        </a>
        <a class="button" href={profile.resume.pdf} target="_blank" rel="noopener">
          Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span>
        </a>
      </div>
    </div>

    <dl class="hero__meta label">
      <div>
        <dt class="muted">Based in</dt>
        <dd>{profile.location}</dd>
      </div>
      <div>
        <dt class="muted">Local time</dt>
        <dd>
          <time data-clock data-time-zone={profile.timeZone}>
            IST, UTC+5:30
          </time>
        </dd>
      </div>
      <div>
        <dt class="muted">Building since</dt>
        <dd>{profile.since}</dd>
      </div>
    </dl>

    <p class="hero__hint label muted" aria-hidden="true">
      <span class="hero__hint-star">✦</span>
      <span class="hero__hint--pointer">Click the sky to make a wish</span>
      <span class="hero__hint--touch">Tap the sky to make a wish</span>
    </p>
  </div>
</section>

<script>
  import { createStarfield } from "../scripts/starfield";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const sky = hero?.querySelector<HTMLCanvasElement>("[data-sky]");
  if (hero && sky) createStarfield(sky, { interactiveArea: hero });

  // The portrait glances toward the pointer: pointer devices only, only when
  // motion is welcome, and it never captures or cancels the event.
  const avatar = hero?.querySelector<SVGSVGElement>("[data-avatar]");
  const canGlance = window.matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
  if (avatar) {
    let pending = false;
    let x = 0;
    let y = 0;
    window.addEventListener(
      "pointermove",
      (event) => {
        if (!canGlance.matches) return;
        x = event.clientX;
        y = event.clientY;
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          pending = false;
          const rect = avatar.getBoundingClientRect();
          const dx = x - (rect.left + rect.width / 2);
          const dy = y - (rect.top + rect.height * 0.52);
          const distance = Math.hypot(dx, dy) || 1;
          const reach = Math.min(1, distance / 400);
          avatar.style.setProperty("--look-x", `${((dx / distance) * 4 * reach).toFixed(2)}px`);
          avatar.style.setProperty("--look-y", `${((dy / distance) * 2.5 * reach).toFixed(2)}px`);
        });
      },
      { passive: true },
    );
  }

  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  const timeZone = clock?.dataset.timeZone;

  if (clock && timeZone) {
    const format = new Intl.DateTimeFormat("en-IN", {
      timeZone,
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const tick = () => {
      clock.textContent = `${format.format(new Date())} IST`;
    };
    tick();
    window.setInterval(tick, 30_000);
  }
</script>

<style>
  .hero {
    /* Stars are drawn in the text colour, so they read on both themes. */
    --star: var(--ink);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .hero__inner {
    display: grid;
    grid-template-areas:
      "eyebrow"
      "portrait"
      "title"
      "foot"
      "meta"
      "hint";
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__eyebrow {
    grid-area: eyebrow;
  }

  .hero__title {
    grid-area: title;
  }

  .hero__foot {
    grid-area: foot;
  }

  .hero__meta {
    grid-area: meta;
  }

  .hero__portrait {
    grid-area: portrait;
    width: clamp(8.5rem, 34vw, 12rem);
  }

  .hero__portrait {
    position: relative;
  }

  /* A moon behind the portrait keeps the dark hair readable on the dark theme. */
  .hero__portrait::before {
    content: "";
    position: absolute;
    inset: 0 2% 16%;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper-raised);
  }

  .hero__portrait :global(.hero__avatar) {
    position: relative;
    width: 100%;
    height: auto;
  }

  .hero__role {
    margin-top: 0.35em;
    font-family: var(--mono);
    font-size: clamp(0.95rem, 0.6rem + 1.4vw, 1.5rem);
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero__hint {
    grid-area: hint;
    display: inline-flex;
    gap: 0.5rem;
    margin-top: -1rem;
  }

  .hero__hint-star {
    color: var(--accent);
  }

  .hero__hint--touch {
    display: none;
  }

  @media (hover: none) {
    .hero__hint--pointer {
      display: none;
    }

    .hero__hint--touch {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__hint {
      display: none;
    }
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "eyebrow eyebrow"
        "title portrait"
        "foot foot"
        "meta meta"
        "hint hint";
    }

    .hero__portrait {
      align-self: center;
      width: clamp(14rem, 24vw, 22rem);
    }
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #1f9d55;
    box-shadow: 0 0 0 0 color-mix(in srgb, #1f9d55 50%, transparent);
  }

  .hero__title {
    display: grid;
    font-size: clamp(4.25rem, 14vw, 13rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .hero__line--indent {
    padding-left: 0.5em;
  }

  .hero__stop {
    color: var(--accent);
  }

  .hero__foot {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .hero__lead {
    max-width: 38ch;
    font-size: clamp(1.25rem, 1.4vw + 0.8rem, 1.75rem);
    line-height: 1.35;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .hero__meta dd {
    margin: 0.35rem 0 0;
  }

  @media (min-width: 60rem) {
    .hero__foot {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 29.99rem) {
    .hero__line--indent {
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__dot {
      animation: pulse 2.4s ease-out infinite;
    }

    .hero__line {
      animation: rise 1s var(--ease-out) both;
    }

    .hero__line--indent {
      animation-delay: 0.08s;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.25em);
      }
    }

    @keyframes pulse {
      70% {
        box-shadow: 0 0 0 0.5rem color-mix(in srgb, #1f9d55 0%, transparent);
      }
    }
  }
</style>
