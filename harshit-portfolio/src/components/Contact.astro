---
import { hireMe, profile } from "../data/profile";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__statement" aria-hidden="true">
    <p>
      Building
      <br />
      with intent
      <br />
      since
    </p>
    <p class="contact__year">{profile.since}</p>
  </div>

  <div class="contact__body grid-bg">
    <h2 class="contact__title" id="contact-title">
      Let's build
    </h2>
    <p class="contact__lead">Have a project, a role or an idea? Say hello.</p>

    <a class="contact__go" href={hireMe}>
      GO<span class="visually-hidden">, email me</span>
    </a>

    <div class="contact__email">
      <a class="contact__address mono" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
      <button class="pill" type="button" data-copy={profile.email} hidden>
        Copy email
      </button>
      <p class="contact__status mono" role="status" aria-live="polite" data-copy-status></p>
    </div>

    <div class="contact__links">
      <div>
        <h3 class="mono">Elsewhere</h3>
        <ul>
          {profile.socials.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener me">
                {social.label}
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="mono">Resume</h3>
        <ul>
          <li>
            <a href={profile.resume.pdf} target="_blank" rel="noopener">
              View PDF<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={profile.resume.docx} download="Harshit_Chauhan_Resume.docx">
              Download DOCX
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");

  // Only offered where the Clipboard API exists; the mailto link always works.
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    let reset = 0;
    button.addEventListener("click", async () => {
      window.clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        status.textContent = "Copied to clipboard";
      } catch {
        status.textContent = "Couldn't copy. Select the address above instead.";
      }
      reset = window.setTimeout(() => {
        status.textContent = "";
      }, 4000);
    });
  }
</script>

<style>
  .contact__statement {
    display: grid;
    justify-items: center;
    padding: clamp(4rem, 12vw, 9rem) var(--gutter) clamp(2rem, 6vw, 4rem);
    border-bottom: 1px solid var(--ink);
    /* Rays fanning out from a point above the text. */
    background: repeating-conic-gradient(from 0deg at 50% 0%, var(--ink) 0 0.15deg, transparent 0.15deg 6deg);
    font-family: var(--display);
    font-weight: 700;
    line-height: 0.85;
    text-align: center;
    text-transform: uppercase;
  }

  .contact__statement p:first-child {
    font-size: clamp(2.5rem, 8vw, 6rem);
    background: var(--red);
    padding: 0.1em 0.2em;
  }

  .contact__year {
    font-size: clamp(7rem, 30vw, 22rem);
    letter-spacing: -0.02em;
    background: var(--red);
    padding-inline: 0.05em;
  }

  .contact__body {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(4rem, 10vw, 7rem) var(--gutter);
    text-align: center;
  }

  .contact__title {
    font-size: clamp(4rem, 14vw, 11rem);
    background: var(--red);
    padding-inline: 0.1em;
  }

  .contact__lead {
    max-width: 24ch;
    font-size: clamp(1.25rem, 1.5vw + 0.9rem, 2rem);
    line-height: 1.2;
    background: var(--red);
  }

  .contact__go {
    display: grid;
    place-items: center;
    width: clamp(5rem, 12vw, 7rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--red);
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }

  .contact__go:hover {
    transform: scale(1.08);
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    padding: 0.75rem 1rem;
    background: var(--red);
    border: 1px solid var(--ink);
  }

  .contact__address {
    font-size: clamp(0.8125rem, 1.5vw, 1rem);
    overflow-wrap: anywhere;
    text-transform: none;
  }

  .contact__status {
    flex-basis: 100%;
    min-height: 1.2em;
  }

  .contact__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 12rem));
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--red);
    border: 1px solid var(--ink);
    text-align: left;
  }

  .contact__links ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__links li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.125rem;
  }
</style>
