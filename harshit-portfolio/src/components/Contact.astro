---
import { hireMe, profile } from "../data/profile";

// "Let's / Rock", each letter drawn as four stacked slices. The apostrophe
// rides on the "t" as a superscript.
const lines = [
  { position: "top", chars: ["L", "e", "t'", "s"] },
  { position: "bottom", chars: ["R", "o", "c", "k"] },
];
const slices = [0, 1, 2, 3];
// Built as a string so formatting can't slip a space between the letter and its superscript.
const sliceHtml = (char: string) => char[0] + (char[1] ? `<span class="sup">${char[1]}</span>` : "");

const star = `<svg class="s__cta__star astro-25kxajgh" width="49" height="49" viewBox="0 0 49 49" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="m24.5 0 3.3 21.2L49 24.5l-21.2 3.3L24.5 49l-3.3-21.2L0 24.5l21.2-3.3L24.5 0z" class="astro-25kxajgh"></path> </svg>`;
---

<section class="s-cta astro-25kxajgh" data-intersect>
  <div id="contact" class="s__inner js-container astro-25kxajgh">
    <div class="s__hover js-hover astro-25kxajgh">
      <div class="s__button js-button astro-25kxajgh">
        <div class="s__button__inner astro-25kxajgh">
          <div class="s__button__text js-button-text astro-25kxajgh">GO</div>
        </div>
      </div>
      <div class="s__cta js-cta astro-25kxajgh">
        {lines.map((line) => (
          <div class={`s__cta__line s__cta__line--${line.position} astro-25kxajgh`}>
            <div class="s__cta__text astro-25kxajgh">
              {line.chars.map((char) => (
                <span class="s__cta__char astro-25kxajgh">
                  {" "}
                  {slices.map(() => (
                    <span class="s__cta__char__slice astro-25kxajgh" set:html={sliceHtml(char)} />
                  ))}{" "}
                </span>
              ))}
            </div>
          </div>
        ))}
        <a href={hireMe} class="s__cta__link astro-25kxajgh">
          {profile.email}
        </a>
        <div class="s__cta__stars astro-25kxajgh">
          {slices.map(() => (
            <Fragment set:html={star} />
          ))}
        </div>
        <div class="a-dots astro-25kxajgh"></div>
      </div>
    </div>
  </div>
  <div class="s__grid js-grid astro-25kxajgh">
    <svg class="s__grid__svg js-grid-svg astro-25kxajgh">
      <path class="s__grid__path js-grid-path astro-25kxajgh" d=""></path>
    </svg>
  </div>
</section>
