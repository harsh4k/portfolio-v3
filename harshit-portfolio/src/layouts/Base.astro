---
import { profile } from "../data/profile";
import { getOrdered } from "../data/collections";
import { structuredData } from "../data/seo";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Regenerate with `npm run og-image` when the name, role or location changes.
const ogImage = new URL("/images/og-image.png", Astro.site);
const ogImageAlt = `${profile.name}, ${profile.role} — ${profile.location}`;

const projects = await getOrdered("projects");
const schema = Astro.site ? structuredData(Astro.site, projects) : undefined;

// The design's fonts, preloaded because the intro and hero render with them first.
const fonts = [
  "PPEditorialNew-Regular",
  "PPEditorialNew-Ultralight",
  "PPFraktionMono-Regular",
  "PPFraktionMono-Bold",
  "Bigger-Display",
];
---

<!doctype html>
<html lang="en" class="is-scroll-blocked astro-j7pv25f6">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/icons/logo.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Harshit" />
    <meta name="theme-color" content="#F40C3F" />
    <meta name="msapplication-navbutton-color" content="#160000" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {fonts.map((font) => (
      <link rel="preload" href={`/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}

    <!--
      The design, copied unchanged from the live site:
      _astro/ is the section styles and GSAP motion engine,
      assets/ is the 3D intro scene's styles (its script loads from bridge.js),
      styles/integration.css joins the two.
    -->
    <link rel="stylesheet" href="/_astro/index.MJ9FiCyD.css" />
    <script is:inline type="module" src="/_astro/hoisted.BvNyQ0G_.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-DG8As337.css" data-intro-style />
    <!-- Start fetching the 3D intro with the page instead of after bridge.js runs. -->
    <link rel="modulepreload" href="/assets/index-wQJ6Ws5X.js" media="(prefers-reduced-motion: no-preference)" />
    <link rel="stylesheet" href="/styles/integration.css" />
    <!-- Must run before the engine: it calls play()/pause() on the card images. -->
    <script is:inline src="/scripts/img-media.js"></script>
    <!-- A data block, not a script, so the CSP's script-src does not apply to it. -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />}
  </head>
  <body class="astro-j7pv25f6">
    <div id="intro-layer" class="intro-layer">
      <!--
        Plain red cover over the 3D scene until it draws its first frame, so a
        half-built scene never shows. bridge.js fades it out and removes it.
      -->
      <div class="intro-loader js-intro-loader" aria-hidden="true"></div>
      <div id="app"></div>
    </div>
    <div class="site-wrapper js-site-wrapper astro-j7pv25f6">
      <slot />
    </div>
    <slot name="after" />
    <script is:inline type="module" src="/scripts/bridge.js"></script>
    <script is:inline type="module" src="/scripts/resume-dock.js"></script>
    <script>
      import "../scripts/warm-images";
      import "../scripts/reveal-highlights";
      import "../scripts/contrast-state";
      import "../scripts/theme-wipe";
    </script>
  </body>
</html>
