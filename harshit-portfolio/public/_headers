/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# The same policy the live site sends. No inline script can run (script-src has
# no 'unsafe-inline'). The copied design sets inline style attributes and uses
# blob: workers and images; 'unsafe-eval' is kept as live has it until the
# engine is confirmed not to need it.
# The two cloudflareinsights.com hosts are Cloudflare Web Analytics: Pages
# injects its beacon script, which reports either to this origin or to
# cloudflareinsights.com depending on how the project is served.

# The /via/ links in _redirects serve the home page under a second path, so
# keep search engines from listing them (the page's canonical is / as well).
/via/*
  X-Robots-Tag: noindex

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The offline worker. Must never be HTTP-cached, or visitors would keep an old
# worker, and with it an old copy of the site, after a deploy.
/sw.js
  Cache-Control: no-cache

# Not immutable: _astro/ also holds the copied design's engine, whose file
# names never change when its contents do. Unchanged files still cost only a 304.
/_astro/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/scripts/*
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
