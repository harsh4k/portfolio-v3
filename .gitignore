# Dependencies
node_modules/
harshit-portfolio/dist/

# Deploy output. Cloudflare Pages builds this itself now
# (npm ci --prefix harshit-portfolio && npm run build -> dist).
# Verified: a clean clone with no references/ reproduces it exactly — 171 files,
# zero missing, zero extra, zero content differences.
/dist/

# Unpacked Word scratch from resume edits
.tmp-docx/
.tmp-docx*/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Tooling output
.playwright-mcp/
harshit-portfolio/test-results/
harshit-portfolio/playwright-report/
harshit-portfolio/blob-report/
harshit-portfolio/.playwright/
.wrangler/
*.log
android/.gradle/
android/**/build/
android/local.properties
android/*.apk
android/*.aab
android/app/release/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Build inputs: full local copies of the two reference sites this design was
# studied from (~203 MB). They are not this project's code and include
# third-party fonts and client videos, so they stay out of the public repo.
# build.mjs detects their absence and skips the HTML compile, keeping the
# committed index.html; the bundle patches still run.
references/

# Byte-identical nested duplicates of directories that already exist one level
# up. Nothing references these paths.
harshit-portfolio/public/_astro/_astro/
harshit-portfolio/public/cdn-cgi/
